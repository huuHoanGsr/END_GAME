<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Leaderboard.uss?fileID=7433441132597879392&amp;guid=cfff9b457eb2cfd408ee0b3277bf9c91&amp;type=3#Leaderboard"/>
    <ui:VisualElement name="leaderboard-overlay" class="overlay">
        <ui:VisualElement class="card">
            <ui:VisualElement class="header-row">
                <ui:Label text="Leaderboard" class="title" />
                <ui:Button name="close-button" text="X" class="icon-button" />
            </ui:VisualElement>

            <ui:Label name="status-label" text="Ready" class="status" />

            <ui:VisualElement class="table-header">
                <ui:Label text="#" class="col-rank" />
                <ui:Label text="Player" class="col-name" />
                <ui:Label text="Score" class="col-score" />
            </ui:VisualElement>

            <ui:ScrollView name="entries-scroll" class="entries-scroll" mode="Vertical" />

            <ui:VisualElement class="footer-row">
                <ui:Button name="refresh-button" text="Refresh" class="main-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
